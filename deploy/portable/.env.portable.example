# Settings of the portable ("green") build, read by deploy\portable\run-native.ps1 (and later by start.bat).
# Copy to deploy\portable\.env.portable (gitignored) and fill in the blanks. KEY=VALUE per line, no quotes.
# A variable already set in the process environment wins over this file; a key missing from both gets the default
# shown in the comment.

# --- required ---------------------------------------------------------------------------------------------
# PostgreSQL. Either give DATABASE_URL (postgresql://user:password@host:port/name; percent-encode special
# characters in the password) or the DB_* keys below. Never commit the filled-in file.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_NAME=qm_center
DB_USER=qm_admin
DB_PASSWORD=
DB_SCHEMA=qip

# --- optional (defaults in brackets) ----------------------------------------------------------------------
# At least 50 random characters. [generated fresh on every run; sessions then end when the server restarts]
# DJANGO_SECRET_KEY=
# [localhost,127.0.0.1]
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Plain http on a workstation, so the cookies must not be https-only. [false, false]
# SESSION_COOKIE_SECURE=false
# CSRF_COOKIE_SECURE=false
# Empty = in-process cache (no Redis in the portable build). [empty]
# REDIS_URL=
# AD login is switched on by IT later. [false]
# LDAP_ENABLED=false
# Static front-end export to serve from "/". [<repo>\out]
# FRONTEND_DIST_DIR=
# Listen address; keep 127.0.0.1 unless IT asks otherwise. [127.0.0.1 and 8011]
# PORTABLE_HOST=127.0.0.1
# PORTABLE_PORT=8011
