# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files: .env (the development stack's, read automatically by Compose), .env.local,
# .env.prod (the production stack's settings, holds secrets), .env.prodtest (local production trial) ...
# only the .env.example (backend) and .env.prod.example (production) templates are tracked
.env*.local
.env
.env.*
!.env.example
!.env.prod.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files
*.xlsx
*.xls

# R
.Rhistory

# claude local settings
.claude/settings.local.json

# real hospital spreadsheets kept out of public/ (never served, never committed)
local-data/

# collectstatic output (the image build fills it; running collectstatic on the host does too)
backend/staticfiles/
