# Environment for running manage.py directly on a workstation (python manage.py runserver / pytest).
# Copy to backend/.env (read by config/settings/base.py, not committed). Containers and cloud platforms use
# the repository root .env.prod.example instead (copied to .env.prod), which also lists the variables only the
# image needs (web build settings, gunicorn, RUN_BOOTSTRAP, ...); see docs/DEPLOYMENT.md.

# Django
# Development only: production (config.settings.prod) refuses this value, anything shorter than 50 characters and
# anything that looks like a placeholder (see docs/DEPLOYMENT.md).
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Production (config.settings.prod) refuses to start without this; development ignores it (any host is allowed).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins (with scheme) allowed to call the API cross-origin / to POST although they differ from the host Django
# sees. Both default to empty in production; development adds the localhost ports of the Next.js dev server on its
# own. Leave these lines commented out unless you need them: a variable that is set but empty REPLACES those
# defaults with an empty list.
# CORS_ALLOWED_ORIGINS=https://qip.example.org
# CSRF_TRUSTED_ORIGINS=https://qip.example.org
# Take the public host name from X-Forwarded-Host (the Next.js /api proxy sends it). Only safe while nothing but
# the proxy can reach Django.
USE_X_FORWARDED_HOST=true

# Production-only security switches (config/settings/prod.py); ignored by development settings.
# HSTS max-age in seconds for Django's own responses; 0 = off. Raise it in steps once https works end to end.
SECURE_HSTS_SECONDS=0
# Redirect http to https inside Django. Leave off when the platform edge does it.
SECURE_SSL_REDIRECT=false
# Cookies over https only. Set both to false only to try the production settings over plain http.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# PostgreSQL. DATABASE_URL, when set, wins over DB_*; e.g. postgres://user:password@host:5432/qm_center?sslmode=require
DATABASE_URL=
DB_NAME=qm_center
DB_USER=qm_admin
DB_PASSWORD=change-me
# Ports: inside the containers PostgreSQL listens on 5432 and Redis on 6379 (what the production compose file and
# the "postgres" / "redis" hosts of docker-compose.yml use). From the host - which is where manage.py runs with
# this file - the development stack publishes them as 5433 and 6380.
DB_HOST=localhost
DB_PORT=5433
# Schema the tables live in (lowercase letters, digits, underscore; PostgreSQL folds an unquoted name to lowercase);
# `manage.py bootstrap` creates it when missing.
DB_SCHEMA=qip
# Seconds a connection is kept for reuse (0 = reconnect per request; development settings always use 0).
DB_CONN_MAX_AGE=60
# Seconds to wait for a connection before giving up (0 = for ever). DATABASE_URL may carry its own connect_timeout.
DB_CONNECT_TIMEOUT=5

# Redis (Django cache: the change-password attempt counters). Leave empty for a per-process in-memory
# cache, which is fine for one process but counts per worker - set it in any multi-worker deployment.
REDIS_URL=redis://localhost:6380/0

# Login protection (django-axes): lock an account after this many failed logins (at least 1) ...
AXES_FAILURE_LIMIT=5
# ... for this many minutes (at least 1)
AXES_COOLOFF_MINUTES=5
# Client address for the lock. INERT unless ALL of these hold:
#   1. django-ipware is installed in the image (it is not today),
#   2. every proxy in front of Django passes X-Forwarded-For,
#   3. AXES_IPWARE_PROXY_COUNT below is the number of those proxies.
# Otherwise axes uses the connection address (REMOTE_ADDR), which behind the Next.js proxy is the
# same for every visitor: the lock then works per account, and anyone who knows an account name
# can lock it. Real per-IP throttling belongs to the platform edge (load balancer / WAF).
AXES_IPWARE_PROXY_COUNT=0
# Request headers that carry the client address, comma separated, first match wins. Keep REMOTE_ADDR
# alone unless 1-3 above hold, then use HTTP_X_FORWARDED_FOR,REMOTE_ADDR (a client can forge the header).
AXES_IPWARE_META_PRECEDENCE_ORDER=REMOTE_ADDR

# Idle timeout of a login in seconds (28800 = 8 hours); every request renews the session
SESSION_COOKIE_AGE=28800

# Change-password guess limit (counted per user in the cache): after this many calls in a row that do not
# prove the current password (at least 1) ...
PASSWORD_CHANGE_FAILURE_LIMIT=5
# ... the next call is refused with 429 too_many_attempts, even with the right password, for this many
# minutes (at least 1)
PASSWORD_CHANGE_COOLOFF_MINUTES=5

# Initial password for `manage.py seed_admin` (start.bat forwards it; the container's `manage.py bootstrap`
# runs seed_admin when it is set). Needed to create or --reset the admin account; the first login must
# change it. Never commit a real value.
SEED_ADMIN_PASSWORD=
