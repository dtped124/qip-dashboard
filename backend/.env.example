# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=qm_center
DB_USER=qm_admin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=qip

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Login protection (django-axes): lock an account after this many failed logins (at least 1) ...
AXES_FAILURE_LIMIT=5
# ... for this many minutes (at least 1)
AXES_COOLOFF_MINUTES=15
# Client address for the lock. INERT unless ALL of these hold:
#   1. django-ipware is installed in the image (it is not today),
#   2. every proxy in front of Django passes X-Forwarded-For,
#   3. AXES_IPWARE_PROXY_COUNT below is the number of those proxies.
# Otherwise axes uses the connection address (REMOTE_ADDR), which behind the Next.js proxy is the
# same for every visitor: the lock then works per account, and anyone who knows an account name
# can lock it. Real per-IP throttling belongs to the platform edge (load balancer / WAF).
AXES_IPWARE_PROXY_COUNT=0
# Request headers that carry the client address, comma separated, first match wins. Keep REMOTE_ADDR
# alone unless 1-3 above hold, then use HTTP_X_FORWARDED_FOR,REMOTE_ADDR (a client can forge the header).
AXES_IPWARE_META_PRECEDENCE_ORDER=REMOTE_ADDR

# Idle timeout of a login in seconds (28800 = 8 hours); every request renews the session
SESSION_COOKIE_AGE=28800

# Initial password for `manage.py seed_admin` (start.bat forwards it). Needed to create or
# --reset the admin account; the first login must change it. Never commit a real value.
SEED_ADMIN_PASSWORD=
