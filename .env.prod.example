# QIP 監測指標系統 — 正式環境變數樣板（docker-compose.prod.yml 與各雲端平台共用）
#
# 用法：複製成 .env.prod 並填值（cp .env.prod.example .env.prod；.env.prod 不入庫），指令一律帶 --env-file：
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# 完整說明、必填清單、本機試跑步驟見 docs/DEPLOYMENT.md。
# 為什麼不是 .env：Compose 會自動讀專案目錄的 .env 來做 ${...} 內插，而開發堆疊（docker-compose.yml）已經在用它
#       （DB_USER、DB_PASSWORD、SEED_ADMIN_PASSWORD）。兩套設定放在同一個檔案，開發的容器會吃到正式的密碼，
#       正式堆疊也可能吃到開發的值。所以這份樣板叫 .env.prod.example，複製出來的是 .env.prod；
#       根目錄的 .env（有的話）只屬於開發堆疊，不要把這份的內容放進去。
# 格式：每個變數上一行是它的說明；不要在值後面接行內註解；值裡避免 $、# 與空白（Compose 會對 $ 做變數內插，
#       # 會被當成註解）。密碼與密鑰用 python -c "import secrets; print(secrets.token_urlsafe(32))" 產生最保險。
# 與 backend/.env.example 的差別：這份給容器／雲端；那份給在主機上直接跑 manage.py（不經 Docker）。
#
# 變數分五組：Web (Next.js)、Django、資料庫與快取、執行與管理、AD／LDAP 登入。
# 「build 時固化」的變數寫在 web 映像裡：改了要重新 build web 映像，只重啟沒有用。

# ══ Web (Next.js) ══════════════════════════════════════════════════════════

# [build 時固化] Next 在伺服器端把 /api/* 轉給誰：從 web 容器看出去的 Django 位址。
# compose 內固定是 http://api:8000；平台上要填 api 服務的內網位址。換位址要重新 build web。
API_INTERNAL_URL=http://api:8000

# [build 時固化] Next 等 Django 回應的逾時毫秒數（匯入與匯出可能很久）；要與 lib/http.ts 的 DOWNLOAD_TIMEOUT_MS 一致。
API_PROXY_TIMEOUT_MS=120000

# [build 時固化] Next 在每個回應加的 Strict-Transport-Security max-age（秒）；0 = 不送。
# HTTPS 確認可用前保持 0：瀏覽器會記住這個值。平台邊緣已送 HSTS 的話可保持 0。
NEXT_HSTS_SECONDS=0

# 只給 docker-compose.prod.yml：web 發佈到主機的埠。平台部署用不到。
WEB_PORT=3000

# 只給 docker-compose.prod.yml：web 發佈到主機的哪個位址。0.0.0.0 = 所有網卡；本機試跑設 127.0.0.1，只有這台機器連得到。
WEB_BIND=0.0.0.0

# 只給 docker-compose.prod.yml：api 服務讀哪一個檔案當容器環境（預設 .env.prod）。
# 本機試跑時在 .env.prodtest 裡寫 ENV_FILE=.env.prodtest，一個 --env-file 就同時管內插與容器環境。
# ENV_FILE=.env.prod

# ══ Django ═════════════════════════════════════════════════════════════════

# 設定模組：容器預設就是 prod，通常不必設。開發用 compose 才是 config.settings.dev。
DJANGO_SETTINGS_MODULE=config.settings.prod

# 必填。簽 session 與 CSRF 的密鑰，至少 50 字元的隨機字串，不可外洩、不可入庫。
# prod 啟動時會檢查：空的、少於 50 字元、或含範本／開發用的字樣（change-me、dev-secret-key、django-insecure- …）都會拒絕啟動。
# 產生：python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# 必填（prod 沒設會拒絕啟動）。逗號分隔的主機名稱：對外網域，加上 Next 轉來的 Host
# （Next 把收到的 Host 放進 X-Forwarded-Host）、以及容器探針用的 localhost。例如 qip.example.org,localhost
DJANGO_ALLOWED_HOSTS=localhost

# 逗號分隔、含 scheme 的來源，例如 https://qip.example.org。同源代理下通常不必填；
# 平台改寫了 Host 或 scheme 導致 POST 被 CSRF 擋下時才填。
CSRF_TRUSTED_ORIGINS=

# 逗號分隔、含 scheme 的跨來源網頁。瀏覽器只連 Next（同源），預設不允許任何其他來源，留空即可。
CORS_ALLOWED_ORIGINS=

# Django 是否信任 X-Forwarded-Host 當作對外主機名稱（Next 代理會送）。只有 Next／平台能連到 Django 時才安全。
USE_X_FORWARDED_HOST=true

# Django 回應的 HSTS max-age（秒），只涵蓋 API 與 admin；HTML 的 HSTS 看 NEXT_HSTS_SECONDS 或平台邊緣。
# 確認 HTTPS 後再分段調高（300、86400、31536000）；0 = 不送。
SECURE_HSTS_SECONDS=0

# Django 是否把 http 請求轉址到 https。預設 false：由平台邊緣轉址；邊緣沒送正確的 X-Forwarded-Proto 就開啟會無限轉址。
SECURE_SSL_REDIRECT=false

# session cookie 是否只走 HTTPS。上線一律 true；只有在本機用 http 試跑時才設 false。
SESSION_COOKIE_SECURE=true

# CSRF cookie 是否只走 HTTPS。同上。
CSRF_COOKIE_SECURE=true

# 登入閒置逾時（秒）；每次請求都會續期。28800 = 8 小時。
SESSION_COOKIE_AGE=28800

# ══ 資料庫與快取 ═══════════════════════════════════════════════════════════

# 連線字串；有填就蓋過下面的 DB_*。託管資料庫給的就是這種字串，例如
# postgres://user:password@host:5432/dbname?sslmode=require （密碼裡的特殊字元要 URL 編碼）
# 留空則使用 DB_*。
DATABASE_URL=

# 資料庫名稱（沒填 DATABASE_URL 時使用）。
DB_NAME=qm_center

# 資料庫使用者。
DB_USER=qm_admin

# 資料庫密碼；須與 POSTGRES_PASSWORD 相同（用 docker-compose.prod.yml 內建的 db 時）。
DB_PASSWORD=

# 資料庫主機；用 docker-compose.prod.yml 內建的 db 時是服務名稱 db。
DB_HOST=db

# 資料庫埠。容器之間走的是 PostgreSQL 的 5432（開發堆疊才有對外的 5433，這個堆疊的 db 不發佈 port）。
DB_PORT=5432

# 資料表所在的 PostgreSQL schema；啟動時 bootstrap 會在不存在時建立它。
# 只接受小寫英文字母、數字與底線，且不以數字開頭（PostgreSQL 會把沒加引號的名稱轉成小寫）。
DB_SCHEMA=qip

# 連線重用秒數；0 = 每個請求重連。蓋過 DATABASE_URL 裡的 conn_max_age。
DB_CONN_MAX_AGE=60

# 連不上資料庫時，每次嘗試等幾秒就放棄（libpq connect_timeout）；0 = 不設逾時（等到作業系統逾時，約兩分鐘）。
# bootstrap 在資料庫還沒起來時會每隔幾秒重試，逾時太長會讓每次重試都卡很久。DATABASE_URL 自帶的 connect_timeout 優先。
DB_CONNECT_TIMEOUT=5

# 只給 docker-compose.prod.yml 內建的 db 容器：初始資料庫、使用者與密碼。要和上面的 DB_* 一致。
POSTGRES_DB=qm_center

# 同上：資料庫使用者。
POSTGRES_USER=qm_admin

# 同上：資料庫密碼（必填）。
POSTGRES_PASSWORD=

# Django cache：存「變更密碼」的猜測次數，也存儀表板（GET /api/v1/dashboard/）算好的回應。
# 留空 = 每個行程各用自己的記憶體：多 worker 時猜測次數各算各的；儀表板快取則預設關閉（見 DASHBOARD_CACHE_ENABLED）——
# 別的行程（管理指令、其他 worker）的寫入清不到 web 行程記憶體裡的那一份，單一 worker 也一樣。建議填。
# 容器之間走 Redis 的 6379（開發堆疊才有對外的 6380）。
REDIS_URL=redis://redis:6379/1

# 連 Redis 與等 Redis 回覆各最多等幾秒（> 0，可帶小數）。redis-py 沒指定時的行為隨版本而異（舊版完全不逾時，新版預設 5 秒），這裡固定下來。
# Redis 不回應（不是拒絕連線）時，每個用到 cache 的請求最多多等這麼久，之後 cache 視為不可用，請求照常處理（變更密碼不節流、儀表板重新計算）。
REDIS_SOCKET_TIMEOUT=2

# 儀表板快取開關。true = 第二次起的 GET /api/v1/dashboard/ 直接取自 cache（回應標頭 X-Dashboard-Cache: HIT）；
# false = 每次都重新計算（標頭 BYPASS）。關掉時資料變動仍會讓版本號前進，之後再開不會讀到關閉期間的舊內容。
# 預設：有填 REDIS_URL 才開，沒填就關——記憶體裡的快取清不到別的行程的寫入（管理指令、其他 worker），會一直回舊資料到 TTL 為止。
# 這一行維持註解就會依 REDIS_URL 決定；明設 true／false 可蓋過（沒有 Redis 還設 true，等於只靠 TTL 保底）。
# DASHBOARD_CACHE_ENABLED=true

# 儀表板快取的保底存活秒數（至少 1）。資料變動（匯入、修正、改目標值、TCPI、後台編輯、管理指令）會立刻使快取失效，
# 這個時間只在「失效通知沒送成」（例如當時 Redis 連不上）時才有作用：最久這麼久之後會讀到新資料。
DASHBOARD_CACHE_TTL=600

# ══ 執行與管理 ═════════════════════════════════════════════════════════════

# 首次建立 admin 帳號的初始密碼；留空就不建立。帳號已存在則略過，所以可以一直留著，建議第一次登入後移除。
# 須通過密碼規則（至少 10 字元、不可太常見、不可全數字）；第一次登入必須改密碼。不要入庫。
SEED_ADMIN_PASSWORD=

# 登入失敗幾次就鎖定該帳號（至少 1）。
AXES_FAILURE_LIMIT=5

# 鎖定幾分鐘（至少 1）。
AXES_COOLOFF_MINUTES=5

# 下面兩個目前沒有作用（保持註解）：它們由 django-ipware 讀取，而映像沒有安裝它，axes 一律用連線位址 REMOTE_ADDR；
# 經 Next 代理後那個位址對所有人都一樣，所以鎖定實質上只看帳號。真正的每 IP 限流在平台邊緣（docs/DEPLOYMENT.md §7-1）。
# 要啟用得先裝 django-ipware、讓前面每一層代理都送 X-Forwarded-For；細節見 backend/.env.example。
# AXES_IPWARE_PROXY_COUNT=0
# AXES_IPWARE_META_PRECEDENCE_ORDER=REMOTE_ADDR

# 變更密碼連續幾次沒能證明目前密碼就暫時拒絕（至少 1）。
PASSWORD_CHANGE_FAILURE_LIMIT=5

# 上述拒絕持續幾分鐘（至少 1）。
PASSWORD_CHANGE_COOLOFF_MINUTES=5

# 容器啟動時是否先跑 bootstrap（等資料庫、建 schema、migrate、seed）。只有 0、false、no（不分大小寫）才略過；
# 其他值（包含留空）都照常執行，免得打錯字就悄悄跳過建表。
RUN_BOOTSTRAP=1

# gunicorn 監聽的埠；許多平台會自行指定 PORT。web 的 API_INTERNAL_URL 要指到這個埠。
PORT=8000

# gunicorn worker 數。
GUNICORN_WORKERS=3

# gunicorn 逾時秒數；匯入與匯出需要較長，120 為預設。
GUNICORN_TIMEOUT=120

# （沒有對應的變數，是部署要求）上傳的檔案放在 api 容器的 /app/media：達文西匯入的「預覽 → 確認」要讀回預覽時存下的檔案。
# 平台上要把 /app/media 掛成持久 volume（對 uid 10001 可寫），而且目前只能跑單一 api 副本——多副本之間沒有共享檔案系統，
# 預覽與確認落在不同副本就會找不到檔案。docker-compose.prod.yml 的 media volume 就是為這個。

# ══ AD／LDAP 登入（預設關閉，資訊室上線時啟用）══════════════════════════════
#
# 預設全部關閉：LDAP_ENABLED 維持 false 時，系統行為與沒有這一組變數完全相同（只比對本地密碼）。
# 由資訊室在上線時把 LDAP_ENABLED 改成 true，並填入下面標「啟用時必填」的四個值（伺服器、bind 帳號、密碼、BASE_DN；
# 實際的值由資訊室提供，不入庫）。啟用後缺任何一個，api 容器會拒絕啟動，錯誤訊息只印鍵名、不印值。
# 啟用後 AD 是唯一的認證來源：帳號必須通過 AD；系統裡的本地帳號只決定這個人的角色與院區。
# 【啟用前的必要條件】品管中心先在 LDAP 仍關閉時，用 admin 登入並建好自己的「AD 員編」管理者帳號
# （帳號＝員工編號，須與 AD 的 sAMAccountName 一致，角色給管理員）。沒做這一步就啟用，系統會沒有任何管理者能登入。
# 格式（已實測）：DN 可含空白，照資訊室給的原樣填；值含 $ 時，整個值用單引號包起來（LDAP_BIND_PASS='…'），
# 否則 Compose 會把 $xxx 換成空字串——密碼開頭是 $ 又沒加引號 → 容器拒絕啟動；$ 在中間 → bind 失敗、所有人看到 503。
# 值裡不要有「空白＋#」（會被當成註解）。
# 步驟與疑難排解見 docs/DEPLOYMENT.md「啟用 AD 登入的順序」。

# AD 驗證總開關。false = 不使用 AD（預設）；true = 啟用。要啟用請先完成上面的必要條件。
LDAP_ENABLED=false

# 啟用時必填。AD 伺服器的位址（主機名稱或 IP），由資訊室提供。api 容器必須連得到它（院內網路）。
LDAP_SERVER_IP=

# AD 伺服器的埠，1–65535。預設 389（明文 bind，與醫中系統相同）。只能填明文 LDAP 埠；不要填 636（LDAPS），本系統不做 TLS。
LDAP_PORT=389

# 啟用時必填。查詢用服務帳號的登入名稱（bind 帳號），由資訊室提供。只用來搜尋員編對應的 DN，不用來登入。
LDAP_BIND_USER=

# 啟用時必填。上述服務帳號的密碼。不要入庫，不要貼進聊天或工單；含 $ 時整個值用單引號包起來（見上方「格式」）。
LDAP_BIND_PASS=

# 啟用時必填。搜尋人員的起點 DN（BASE_DN），由資訊室提供。DN 可含空白，照原樣填；含 $ 時整個值用單引號包起來。
LDAP_BASE_DN=

# 連線與等待回覆的逾時秒數（大於 0，可帶小數）。預設 3。AD 完全連不上時，一次登入最壞約等 5 倍這個秒數，
# 之後 30 秒內的登入直接回「無法連線到院內 AD」，不再重試。
LDAP_TIMEOUT=3

# AD 驗證成功、但系統沒有此帳號時，是否自動建立。預設 false：回「AD 驗證成功，但系統尚未開通此帳號，請洽品管中心」，
# 帳號由品管中心在帳號管理頁開通。維持 false 才符合「開通權在品管中心」。
LDAP_AUTO_CREATE=false

# 自動建立帳號（LDAP_AUTO_CREATE=true）時給的角色。只接受 viewer 或 reporter。LDAP_AUTO_CREATE 為 false 時用不到。
LDAP_DEFAULT_ROLE=viewer

# 不走 AD、只比對本地密碼的帳號，逗號分隔的員工編號，例如 admin。清單比對不分大小寫，但登入時帳號要與系統內寫法完全相同（admin 不能打成 ADMIN）。
# 預設留空 = 純 AD：所有帳號都必須通過 AD，連 admin 也登不進去。要保留一個不依賴 AD 的緊急管理者，就把它填在這裡
# （此時 AD 當機，清單內的帳號仍可用本地密碼登入）。清單內的帳號永遠不會被送去 AD。
LDAP_LOCAL_ONLY_ACCOUNTS=
